  <Placemark id="ocupaciones_tramos.1">
	<ExtendedData><SchemaData schemaUrl="#ocupaciones_tramos">
		<SimpleData name="servei">REVISIÓN TUBERÍAS</SimpleData>
		<SimpleData name="tecnic"></SimpleData>
		<SimpleData name="contratista">UTE PASSEIG MARITIM</SimpleData>
		<SimpleData name="cap_obra"></SimpleData>
		<SimpleData name="emplazamiento">AVDA. GABRIEL ROCA, desde Avda. Argentina hasta torre Pelaires</SimpleData>
		<SimpleData name="descripcion">Necesitamos la ocupación de carril lado tierra, el más cercano a la banda de estacionamiento del lado tierra y aparcamientos, para la revisión de tuberías existentes, en tramos alternativamente de unos 5mts. que ocupara el camión de Osifar, que es la empresa que va ha revisar las tuberías. El horario se comprenderá entre las 07'00h y 18h.</SimpleData>
		<SimpleData name="tipo_obra">Revisión de tuberías, con cámara.</SimpleData>
		<SimpleData name="observaciones">INDISPENSABLE PAGATINAS PROHIBIDO APARCAR PARA UN APARCAMIENTO DEL LADO TIERRA</SimpleData>
		<SimpleData name="condicions_mobilitat"></SimpleData>
		<SimpleData name="f_inicio">20260909</SimpleData>
		<SimpleData name="f_fin">20261109</SimpleData>
		<SimpleData name="ID">1</SimpleData>
		<SimpleData name="estado_geo">EXACTO_GOOGLE</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>2.6405968,39.5733148,0</coordinates></Point>
  </Placemark>
  <Placemark id="ocupaciones_tramos.2">
	<ExtendedData><SchemaData schemaUrl="#ocupaciones_tramos">
		<SimpleData name="servei">ENLLUMENAT PUBLIC</SimpleData>
		<SimpleData name="tecnic"></SimpleData>
		<SimpleData name="contratista">EDISON NEXT</SimpleData>
		<SimpleData name="cap_obra"></SimpleData>
		<SimpleData name="emplazamiento">Avenida Alemanya</SimpleData>
		<SimpleData name="descripcion">Montaje de luces de Navidad desde la calle. Con ocupación de acera y carril de taxi-bus.</SimpleData>
		<SimpleData name="tipo_obra">OCUPACIÓN VÍA PÚBLICA, TRABAJOS DE ALUMBRADO PÚBLICO, OCUPACIÓN CALZADA (CARRIL DE TAXI-BUS).</SimpleData>
		<SimpleData name="observaciones">Ocupación (ver plano)</SimpleData>
		<SimpleData name="condicions_mobilitat"></SimpleData>
		<SimpleData name="f_inicio">20260929</SimpleData>
		<SimpleData name="f_fin">20261005</SimpleData>
		<SimpleData name="ID">12</SimpleData>
		<SimpleData name="estado_geo">EXACTO</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>2.6477119,39.577519,0</coordinates></Point>
  </Placemark>
  <Placemark id="ocupaciones_tramos.3">
	<ExtendedData><SchemaData schemaUrl="#ocupaciones_tramos">
		<SimpleData name="servei">ENLLUMENAT PUBLIC</SimpleData>
		<SimpleData name="tecnic"></SimpleData>
		<SimpleData name="contratista">EDISON NEXT</SimpleData>
		<SimpleData name="cap_obra"></SimpleData>
		<SimpleData name="emplazamiento">AV. GASPAR BENNASAR, 1 AL 73</SimpleData>
		<SimpleData name="descripcion">Montaje de elementos navideños (árboles, guirnaldas y decoración). Para la ejecución de los trabajos se regulará con corte carril con tráfico alternativo mediante señalistas. Se realizará por tramo con las fechas indicadas en plano.</SimpleData>
		<SimpleData name="tipo_obra">OCUPACIÓN VÍA PÚBLICA, TRABAJOS DE ALUMBRADO PÚBLICO, SIN CORTES DE TRÁFICO, corte carril con tráfico alternativo mediante señalistas.</SimpleData>
		<SimpleData name="observaciones">La ocupación se realizará conforme al plano adjunto. En las zonas afectadas por líneas de la EMT, los trabajos se ejecutarán en el menor tiempo posible con el fin de minimizar las afecciones al servicio. Asimismo, se comunicará a la EMT cualquier modificación de la planificación prevista, así como la finalización anticipada de los trabajos, en caso de producirse. Fines de semana no se trabaja.</SimpleData>
		<SimpleData name="condicions_mobilitat"></SimpleData>
		<SimpleData name="f_inicio">20260925</SimpleData>
		<SimpleData name="f_fin">20261007</SimpleData>
		<SimpleData name="ID">21</SimpleData>
		<SimpleData name="estado_geo">EXACTO</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>2.6580374,39.582871,0</coordinates></Point>
  </Placemark>
