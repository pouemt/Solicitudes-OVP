  <Placemark id="ocupaciones_tramos.3">
	<ExtendedData><SchemaData schemaUrl="#ocupaciones_tramos">
		<SimpleData name="servei">ENLLUMENAT PUBLIC</SimpleData>
		<SimpleData name="tecnic"></SimpleData>
		<SimpleData name="contratista">EDISON NEXT</SimpleData>
		<SimpleData name="cap_obra"></SimpleData>
		<SimpleData name="emplazamiento">AV. GASPAR BENNASAR, 1 AL 73</SimpleData>
		<SimpleData name="descripcion">Montaje de elementos navideños (árboles, guirnaldas y decoración). Para la ejecución de los trabajos se regulará con corte carril con tráfico alternativo mediante señalistas. Se realizará por tramo con las fechas indicadas en plano.</SimpleData>
		<SimpleData name="tipo_obra">OCUPACIÓN VÍA PÚBLICA, TRABAJOS DE ALUMBRADO PÚBLICO, SIN CORTES DE TRÁFICO, corte carril con tráfico alternativo mediante señalistas.</SimpleData>
		<SimpleData name="observaciones">La ocupación se realizará conforme al plano adjunto. En las zonas afectadas por líneas de la EMT, los trabajos se ejecutarán en el menor tiempo posible con el fin de minimizar las afecciones al servicio. Asimismo, se comunicará a la EMT cualquier modificación de la planificación prevista, así como la finalización anticipada de los trabajos, en caso de producirse. Fines de semana no se trabaja.</SimpleData>
		<SimpleData name="condicions_mobilitat"></SimpleData>
		<SimpleData name="f_inicio">20260925</SimpleData>
		<SimpleData name="f_fin">20261007</SimpleData>
		<SimpleData name="ID">21</SimpleData>
		<SimpleData name="estado_geo">EXACTO</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>2.6580374,39.582871,0</coordinates></Point>
  </Placemark>
