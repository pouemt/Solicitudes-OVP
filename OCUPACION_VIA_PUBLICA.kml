  <Placemark id="ocupaciones_tramos.6">
	<ExtendedData><SchemaData schemaUrl="#ocupaciones_tramos">
		<SimpleData name="servei">Obras I Projectes de EMAYA.</SimpleData>
		<SimpleData name="tecnic"></SimpleData>
		<SimpleData name="contratista">MELCHOR MASCARÓ</SimpleData>
		<SimpleData name="cap_obra"></SimpleData>
		<SimpleData name="emplazamiento">C. Caro con C. Argentina</SimpleData>
		<SimpleData name="descripcion">Ejecución red alcantarilado y red abastecimiento</SimpleData>
		<SimpleData name="tipo_obra">PROYECTO DE RENOVACION DE RED DE AGUA POTABLE Y ALCANTARILLADO EN SANTA CATALINA - FASE 1</SimpleData>
		<SimpleData name="observaciones">Ocupación carril derecho en sentido del tráfico.

La ejecución del cruce se fectuará en horario nocturno por fases para minimizar la afección al tráfico de c. Caro.

En horario diurno se mantendrán al menos dos carriles de circulación en c. Caro.</SimpleData>
		<SimpleData name="condicions_mobilitat">La ejecución del cruce se realizará en la noche del domingo y del lunes en horario nocturno.</SimpleData>
		<SimpleData name="f_inicio">20261023</SimpleData>
		<SimpleData name="f_fin">20261030</SimpleData>
		<SimpleData name="ID">121</SimpleData>
		<SimpleData name="estado_geo">EXACTO_GOOGLE</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>2.6403753,39.5725853,0</coordinates></Point>
  </Placemark>
  <Placemark id="ocupaciones_tramos.7">
	<ExtendedData><SchemaData schemaUrl="#ocupaciones_tramos">
		<SimpleData name="servei">ENLLUMENAT PUBLIC</SimpleData>
		<SimpleData name="tecnic"></SimpleData>
		<SimpleData name="contratista">EDISON NEXT</SimpleData>
		<SimpleData name="cap_obra"></SimpleData>
		<SimpleData name="emplazamiento">C. INDALECIO PRIETO, 1</SimpleData>
		<SimpleData name="descripcion">Trabajos de montaje de elementos de Navidad (árboles), con ocupación temporal en calzada, alternando ambos carriles, con posibles cortes puntuales.  Se realizará entre las 08:00 y las 15:00 horas. Durante la ejecución de los trabajos se instalará la señalización y los elementos de protección necesarios para garantizar la seguridad de los peatones. Se solicita presencia policial por seguridad.</SimpleData>
		<SimpleData name="tipo_obra">OCUPACIÓN VÍA PÚBLICA, TRABAJOS DE ALUMBRADO PÚBLICO.</SimpleData>
		<SimpleData name="observaciones">Ocupación (ver plano).</SimpleData>
		<SimpleData name="condicions_mobilitat">Circulación posible en ambos sentidos en todo momento, aunque sea con trafico alterno</SimpleData>
		<SimpleData name="f_inicio">20261022</SimpleData>
		<SimpleData name="f_fin">20261029</SimpleData>
		<SimpleData name="ID">133</SimpleData>
		<SimpleData name="estado_geo">EXACTO</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>2.6749618,39.5794406,0</coordinates></Point>
  </Placemark>
