  <Placemark id="ocupaciones_tramos.1">
	<ExtendedData><SchemaData schemaUrl="#ocupaciones_tramos">
		<SimpleData name="servei">REVISIÓN TUBERÍAS</SimpleData>
		<SimpleData name="tecnic"></SimpleData>
		<SimpleData name="contratista">UTE PASSEIG MARITIM</SimpleData>
		<SimpleData name="cap_obra"></SimpleData>
		<SimpleData name="emplazamiento">AVDA. GABRIEL ROCA, desde Avda. Argentina hasta torre Pelaires</SimpleData>
		<SimpleData name="descripcion">Necesitamos la ocupación de carril lado tierra, el más cercano a la banda de estacionamiento del lado tierra y aparcamientos, para la revisión de tuberías existentes, en tramos alternativamente de unos 5mts. que ocupara el camión de Osifar, que es la empresa que va ha revisar las tuberías. El horario se comprenderá entre las 07'00h y 18h.</SimpleData>
		<SimpleData name="tipo_obra">Revisión de tuberías, con cámara.</SimpleData>
		<SimpleData name="observaciones">INDISPENSABLE PAGATINAS PROHIBIDO APARCAR PARA UN APARCAMIENTO DEL LADO TIERRA</SimpleData>
		<SimpleData name="condicions_mobilitat"></SimpleData>
		<SimpleData name="f_inicio">20260909</SimpleData>
		<SimpleData name="f_fin">20261109</SimpleData>
		<SimpleData name="ID">1</SimpleData>
		<SimpleData name="estado_geo">EXACTO_GOOGLE</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>2.6405968,39.5733148,0</coordinates></Point>
  </Placemark>
